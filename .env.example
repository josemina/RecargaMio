# Copiar a .env y cambiar los valores. Nunca subir .env al repositorio.
DB_PASSWORD=cambiar
JWT_SECRETO_ACCESO=cambiar-por-uno-largo
JWT_SECRETO_RENOVACION=cambiar-por-otro-largo
RECAUDO_API_KEY=cambiar

# Dirección pública de la API: se usa en el enlace del correo de recuperación de contraseña.
# Para abrir el enlace desde el teléfono, usa la IP del equipo en la red local (ej.: http://192.168.1.20:3000).
API_URL_PUBLICA=http://localhost:3000

# Número de la tarjeta MIO cifrado (ADR 0009). Generar cada una con: openssl rand -hex 32
TARJETA_LLAVE_CIFRADO=cambiar-64-caracteres-hex
TARJETA_LLAVE_HMAC=cambiar-otros-64-caracteres-hex

# Contraseña de la usuaria de prueba que crea el seed (solo desarrollo)
SEMILLA_CONTRASENA=cambiar

# Pasarela de pagos: 'simulada' (sin llaves, mismos datos de prueba de Wompi) o 'wompi' (Sandbox real, ADR 0013)
PASARELA=simulada
# Segundos que tarda la pasarela simulada en confirmar el pago (en milisegundos)
PASARELA_SIMULADA_DEMORA_MS=4000

# Wompi en modo Sandbox: solo se aceptan prefijos de prueba
WOMPI_URL=https://sandbox.wompi.co/v1
WOMPI_LLAVE_PUBLICA=pub_test_xxx
WOMPI_LLAVE_PRIVADA=prv_test_xxx
WOMPI_SECRETO_EVENTOS=test_events_xxx
WOMPI_SECRETO_INTEGRIDAD=test_integrity_xxx

APP_URL_RETORNO=recargamio://recarga
# Notificaciones push (T6, opcional): cuenta de servicio de Firebase en secrets/firebase.json (nunca en el repositorio).
# En Docker la ruta es /app/secrets/firebase.json. Si el archivo no existe, los avisos quedan solo en la bandeja de la app.
FIREBASE_CREDENCIALES_JSON=./secrets/firebase.json
# Cada cuánto se revisan las alertas de saldo bajo (5 minutos)
INTERVALO_ALERTAS_MS=300000

# ── Pruebas automatizadas (T8, ADR 0016) ──
# Contraseña de los usuarios de pruebas (carga001…carga100, integracion y zap @recargamio.test).
# Mínimo 8 caracteres con letras y números. No es la de Viviana. «npm run pruebas» la usa para ingresar.
PRUEBAS_CONTRASENA=cambiar1
# Solo para pruebas de carga y de seguridad: «npm run pruebas» lo cambia y lo restaura solo. Nunca en producción.
# LIMITES_PETICIONES=normal
# Orígenes web con CORS, separados por comas (por ejemplo http://localhost:8081). Vacío: sin CORS (la app nativa no lo necesita).
CORS_ORIGENES=
